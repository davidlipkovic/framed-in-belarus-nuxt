@import "../../assets/style/globalPartials/variables.scss";
@import "../../assets/style/mixins/general";

@include buttons;

.aboutUs {
  flex-direction: column;
  align-items: center;
  margin-top: 2rem;

  .logo {
    max-width: 21.688rem;
    height: auto;
    margin-bottom: 2rem;

    * {
      max-width: 21.688rem;
      width: 100%;
      border-radius: 0;
    }
  }

  .button {
    min-width: 200px;
  }
}

@media screen and (min-width: $br-point-md) {
  .aboutUs {
    flex-direction: row;
    align-items: flex-start;

    .logo {
      margin-bottom: 0;
      margin-right: 2rem;

      * {
        width: 21.688rem;
      }
    }
  }
}
@media screen and (min-width: $br-point-lg) {
  .News.content {
    width: 57.063rem;
  }
}
